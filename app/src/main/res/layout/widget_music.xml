<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/glass_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/m_art"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/m_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/m_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/m_prev"
                    android:layout_width="44dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/music_prev"
                    android:padding="8dp"
                    android:src="@drawable/ic_prev" />

                <ImageView
                    android:id="@+id/m_play"
                    android:layout_width="48dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/music_play_pause"
                    android:padding="6dp"
                    android:src="@drawable/ic_play" />

                <ImageView
                    android:id="@+id/m_next"
                    android:layout_width="44dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/music_next"
                    android:padding="8dp"
                    android:src="@drawable/ic_next" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
